<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — Play Store Compliant
  ================================================
  - Production (api-prod.agrifarms.in): HTTPS only, no cleartext allowed.
  - Dev local IP (192.168.x.x / localhost): Cleartext allowed ONLY in debug builds.
    This block is safely ignored on production/release builds.
-->
<network-security-config>

    <!-- Production domains: HTTPS only, full certificate validation -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">agrifarms.in</domain>
        <domain includeSubdomains="true">api-prod.agrifarms.in</domain>
        <domain includeSubdomains="true">auth-prod.agrifarms.in</domain>
    </domain-config>

    <!-- Allow cleartext HTTP for local development only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.29.57</domain>
        <domain includeSubdomains="true">192.168.29.237</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- Default: all other domains must use HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug builds: also trust user-installed certificates (for Charles/Fiddler proxy) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
